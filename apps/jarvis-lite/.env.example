# Run `python -m jarvis_lite.cli init-demo` to generate private local values.
JARVIS_ENV=development
JARVIS_DATABASE_URL=sqlite:///.local/jarvis.db
JARVIS_ALLOW_LIVE=false
JARVIS_WORKER_ENABLED=true
# Required in production. Generate privately; never commit actual values.
JARVIS_SESSION_SECRET=
JARVIS_ENCRYPTION_KEY=
JARVIS_BOOTSTRAP_EMAIL=
JARVIS_BOOTSTRAP_PASSWORD=
# Optional additional process-level stop; clearing this never resumes paused jobs.
KILL_SWITCH=false
