# Run `python -m jarvis_lite.cli init-demo` to generate private local values.
JARVIS_ENV=development
JARVIS_DATABASE_URL=sqlite:///.local/jarvis.db
JARVIS_ALLOW_LIVE=false
# v1.4 capabilities are independent, opt-in and disabled when omitted.
# Keep them false during review. Keys/configuration do not grant live authority.
# Paid AI also needs explicit administrator activation, reviewed compatible
# model settings, documented FX, remaining budget and a clear emergency stop.
JARVIS_ALLOW_PAID_AI=false
JARVIS_ALLOW_RESEARCH_NETWORK=false
# Retained for compatibility: v1.4 always blocks REAL customer contact and
# payment requests, even if old environment flags or approvals are true.
JARVIS_ALLOW_LIVE_CONTACT=false
JARVIS_ALLOW_LIVE_PAYMENTS=false
# Optional server-side AI key. An encrypted administrator-configured key takes
# precedence; never expose either key through frontend/public environment values.
OPENROUTER_API_KEY=
# Optional server-only email credentials; encrypted stored keys take precedence.
# Canonical incoming/delivery events require an authenticated signing gateway.
BREVO_API_KEY=
EMAIL_WEBHOOK_SECRET=
EMAIL_DELIVERY_WEBHOOK_SECRET=
# Optional server-only Stripe keys; use test credentials during review.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
JARVIS_WORKER_ENABLED=true
# No new scheduler/broker variables: internal recurring schedules live in the
# existing database and require explicit administrator opt-in. Default off.
# Weekly cadence, per-run costs and AI daily/monthly ceilings are reviewed
# database configuration, not new environment flags or spending permission.
# Failed-step recovery and role token limits also require explicit admin review.
# Provider timeout remains capped at 20s; do not add a 120s environment override.
# Required in production. Generate privately; never commit actual values.
JARVIS_SESSION_SECRET=
JARVIS_ENCRYPTION_KEY=
JARVIS_BOOTSTRAP_EMAIL=
JARVIS_BOOTSTRAP_PASSWORD=
# Optional additional process-level stop; clearing this never resumes paused jobs.
KILL_SWITCH=false
